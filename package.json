{
  "name": "vigil",
  "version": "1.0.0",
  "private": true,
  "description": "Vigil — API uptime monitor, webhook inspector & live incident telemetry.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:standalone": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:studio": "prisma studio",
    "db:embedded": "node scripts/embedded-db.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@upstash/redis": "^1.35.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^2.6.0",
    "undici": "^7.10.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "postcss": "^8.4.49",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.1"
  },
  "optionalDependencies": {
    "embedded-postgres": "^18.7.0-beta.19",
    "@embedded-postgres/windows-x64": "^18.7.0-beta.19",
    "@embedded-postgres/linux-x64": "^18.7.0-beta.19"
  }
}
