# ─── Database (Neon / Supabase / local Postgres) ────────────────────────────
# Neon: use the *pooled* connection string here …
DATABASE_URL="postgresql://USER:PASSWORD@HOST/vigil?sslmode=require"
# … and the *direct* (non-pooled) string here for migrations. Locally, use the same value twice.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/vigil?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
# Public origin of this deployment. Used to resolve internal /api/sim/* demo monitors.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
APP_URL="http://localhost:3000"

# ─── Vercel Cron & Operator Protection ───────────────────────────────────────
# Vercel sends `Authorization: Bearer $CRON_SECRET` to /api/cron/probe.
CRON_SECRET="replace-with-a-long-random-string"

# Locks the whole console (pages + APIs) behind a sign-in at /unlock.
# Public without it: /status/*, /api/status/*, /api/ingest/*, the /api/sim/* demo
# services and /api/cron/* (CRON_SECRET). Scripts can send Authorization: Bearer
# <secret> or x-operator-secret. Required in production; unset in local dev = no lock.
VIGIL_OPERATOR_SECRET="replace-with-a-strong-random-operator-secret"

# ─── Rate limiting (optional) ────────────────────────────────────────────────
# Leave blank to use the in-memory token bucket (fine for local dev / single instance).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Token bucket for /api/ingest/:token — capacity and refill rate (tokens per second).
INGEST_BUCKET_CAPACITY="30"
INGEST_BUCKET_REFILL_PER_SEC="0.5"

# ─── Alerts & retention (optional) ───────────────────────────────────────────
# Incoming-webhook URL notified when an incident opens or resolves.
# Slack / Mattermost / Google Chat ({"text"}) or Discord ({"content"}, auto-detected).
ALERT_WEBHOOK_URL=""

# Raw check history kept for this many days (min 31; the status page reads 30).
# Older checks are deleted by /api/cron/probe; daily rollups are kept forever.
CHECK_RETENTION_DAYS="35"
